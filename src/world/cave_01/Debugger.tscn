[gd_scene format=4]

[sub_resource type="GDScript" id="DebugS"]
script/source = "extends Node
func _ready():
    var player = get_tree().get_first_node_in_group(\"\"player\"\")
    if not player:
        # Try finding by name
        var root = get_tree().root
        player = root.get_node_or_null(\"CaveLevel/Player\")
    if player:
        print(\"[DEBUG] Player found: \", player.name)
        print(\"[DEBUG] Script: \", player.get_script())
        print(\"[DEBUG] has _physics_process: \", player.has_method(\"_physics_process\"))
        print(\"[DEBUG] has move_speed: \", \"move_speed\" in player)
    else:
        print(\"[DEBUG] Player NOT found in tree\")

func _process(_d):
    var root = get_tree().root
    var player = root.get_node_or_null(\"CaveLevel/Player\")
    if player:
        FileAccess.open(\"res://debug_movement.txt\", FileAccess.WRITE).store_string(str(player.velocity))
"

[node name="Debugger" type="Node" script=SubResource("DebugS")]
